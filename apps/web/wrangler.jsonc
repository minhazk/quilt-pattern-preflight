{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiltpreflight",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "preflight.emkayfoundry.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://preflight.emkayfoundry.com",
    "NEXT_PUBLIC_NEON_AUTH_URL": "https://ep-aged-frog-awfak2fc.neonauth.c-12.us-east-1.aws.neon.tech/neondb/auth",
    "NEXT_PUBLIC_NEON_DATA_API_URL": "https://ep-aged-frog-awfak2fc.apirest.c-12.us-east-1.aws.neon.tech/neondb/rest/v1",
    "NEON_AUTH_BASE_URL": "https://ep-aged-frog-awfak2fc.neonauth.c-12.us-east-1.aws.neon.tech/neondb/auth",
    "RAW_FILE_RETENTION_DAYS": "30",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
